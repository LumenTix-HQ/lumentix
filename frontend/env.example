# Copy this file to .env.local before running `npm run dev`:
#
#   cp env.example .env.local
#
# Every NEXT_PUBLIC_* value is inlined into the browser bundle at build time,
# so never put secrets in this file.

# ─── Stellar network ──────────────────────────────────────────────────────────
# Network the wallet must be connected to. Options: testnet, mainnet.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# Horizon endpoint for the network above.
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# For mainnet, use:
# NEXT_PUBLIC_STELLAR_NETWORK=mainnet
# NEXT_PUBLIC_HORIZON_URL=https://horizon.stellar.org

# ─── Backend API ──────────────────────────────────────────────────────────────
# Origin of the NestJS backend. Browser code never calls this directly: the
# Next.js route handler at /api/proxy attaches the HttpOnly auth cookie and
# forwards the request here, so this is a server-side setting in practice.
#
# The backend defaults to PORT=3000, which is also `next dev`'s port. Either
# run `next dev` on another port (`npm run dev -- -p 3001`) or start the
# backend with `PORT=8000 npm run start:dev` to match the value below.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public origin of the deployed frontend. Used for absolute URLs in
# sitemap.xml, robots.txt and share links. Falls back to https://lumentix.app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── next/image allowlist ─────────────────────────────────────────────────────
# Comma-separated https hosts that next/image may optimize (event and sponsor
# logos). Wildcards such as `*.example.com` are allowed per host, but a blanket
# `**` and plain http hosts are not. Defaults to images.unsplash.com.
NEXT_PUBLIC_IMAGE_HOSTS=images.unsplash.com

# ─── Analytics (optional) ─────────────────────────────────────────────────────
# Analytics collector base URL (e.g. a self-hosted Plausible/Umami endpoint).
# The origin is added to the CSP connect-src allowlist. Analytics is silently
# disabled when this is unset.
NEXT_PUBLIC_ANALYTICS_URL=

# ─── Platform account ─────────────────────────────────────────────────────────
# Public key of the platform/escrow account used for on-chain operations.
NEXT_PUBLIC_PLATFORM_ACCOUNT=YOUR_PLATFORM_ACCOUNT_PUBLIC_KEY

# ─── Push notifications (optional) ────────────────────────────────────────────
# Web Push VAPID public key. Generate a VAPID key pair and expose the public key
# here to enable push notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── WalletConnect (optional) ─────────────────────────────────────────────────
# WalletConnect project id (required to enable the WalletConnect connector).
# Obtain one at https://cloud.walletconnect.com. Leave unset to disable
# WalletConnect; Freighter still works.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
