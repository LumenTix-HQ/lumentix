# Stellar Network Configuration
# Options: testnet, mainnet
# Note: Wallet connection will validate against this network
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# For mainnet, use:
# NEXT_PUBLIC_STELLAR_NETWORK=mainnet
# NEXT_PUBLIC_HORIZON_URL=https://horizon.stellar.org

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public base URL of the deployed frontend. Used to generate absolute URLs in
# sitemap.xml and robots.txt. Falls back to https://lumentix.app when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Analytics collector base URL (e.g. a self-hosted Plausible/Umami endpoint).
# Analytics is silently disabled when this is unset.
NEXT_PUBLIC_ANALYTICS_URL=

# Platform Account (for escrow and operations)
NEXT_PUBLIC_PLATFORM_ACCOUNT=YOUR_PLATFORM_ACCOUNT_PUBLIC_KEY
